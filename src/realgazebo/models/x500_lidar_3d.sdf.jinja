<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_lidar_3d'>
    <include merge='true'>
      <uri>x500</uri>
    </include>
    <include merge='true'>
      <uri>model://lidar_3d</uri>
      <pose relative_to="base_link">0 0 -0.35 0 3.14159 0</pose>
    </include>
    <joint name="LidarJoint" type="fixed">
      <parent>base_link</parent>
      <child>link</child>
    </joint>
    <plugin filename="libRealGazebo.so" name="custom::RealGazebo">
      <unreal_ip>{{ unreal_ip }}</unreal_ip>
      <unreal_port>{{ unreal_port }}</unreal_port>
      <type_code>6</type_code>
      <motorJointList>
        <motorJoint name="rotor_0_joint"/>
        <motorJoint name="rotor_1_joint"/>
        <motorJoint name="rotor_2_joint"/>
        <motorJoint name="rotor_3_joint"/>
      </motorJointList>
    </plugin>
  </model>
</sdf>
