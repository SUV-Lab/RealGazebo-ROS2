# Local rebake: overlay the CURRENT working tree onto the dependency base
# image and rebuild only RealGazebo-ROS2 (PX4 and all system deps stay
# baked). Use this to test unpushed changes; pushed branches are baked
# reproducibly with docker/Dockerfile.publish instead.
#
# Build (from the repo root; the tag shadows the published image):
#   docker build -f docker/Dockerfile.dev -t mdeagewt/realgazebo:ue5.7 .
FROM aware4docker/realgazebo:1.2

USER user
# Overlay the working tree onto the baked checkout; the image's existing
# build/ is kept so unchanged packages (px4_msgs etc.) rebuild as no-ops.
COPY --chown=user:user . /home/user/realgazebo/RealGazebo-ROS2
RUN cd /home/user/realgazebo/RealGazebo-ROS2 \
    && . /opt/ros/jazzy/setup.sh \
    && colcon build --symlink-install

USER root
