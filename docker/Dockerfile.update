# Local rebake: overlay the CURRENT working tree onto the released image and
# rebuild only RealGazebo-ROS2 (PX4 and all system deps stay baked).
# Use this until the changes are pushed/tagged and the full Dockerfile
# (which clones by git tag) can produce an official image.
#
# Build (from the repo root):
#   docker build -f docker/Dockerfile.update -t aware4docker/realgazebo:1.2-manager .
FROM aware4docker/realgazebo:1.2

USER user
# Overlay the working tree onto the baked checkout; the image's existing
# build/ is kept so unchanged packages (px4_msgs etc.) rebuild as no-ops.
COPY --chown=user:user . /home/user/realgazebo/RealGazebo-ROS2
RUN cd /home/user/realgazebo/RealGazebo-ROS2 \
    && . /opt/ros/jazzy/setup.sh \
    && colcon build --symlink-install

USER root
